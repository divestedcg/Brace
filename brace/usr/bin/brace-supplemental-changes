#but WITHOUT ANY WARRANTY; without even the implied warranty of
#MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
#GNU Affero General Public License for more details.
#
#You should have received a copy of the GNU Affero General Public License
#along with this program.  If not, see <https://www.gnu.org/licenses/>.

if [ "$(/usr/bin/id -u)" -eq "0" ]; then
	if [ -f "/usr/lib/systemd/system/fstrim.timer" ]; then
		echo "Enabling weekly fstrim";
		systemctl enable fstrim.timer --now;
	fi;

	echo "Unconditionally masking unwanted services";
	systemctl mask --now avahi-daemon.service avahi-daemon.socket;
	systemctl mask --now cups-browsed.service;
	systemctl mask --now geoclue.service;
	systemctl mask --now passim.service;
	systemctl mask --now packagekit.service;
	systemctl --global mask localsearch-3.service tracker-miner-fs-3.service;

	#PAM
	if [ -x /usr/bin/authselect ]; then
		echo "Set recommended authselect profile & features?";
		echo -e "Current config:\n$(authselect current)";
		select ys in "Yes" "Skip"; do
			case $ys in
				Yes )
					#this automatically:
					# - enables lastlog printing
					# - disables sssd, mdns, fingerprint support
					#flags then:
					# - enable locking for 10 minutes after 3 failed attempts
					# - prevent access to accounts with empty password set
					authselect select local with-faillock without-nullok;
					echo -e "New config:\n$(authselect current)";
					break;;
				Skip )
					break;;
			esac
		done
	fi

	#Stealth Firewall
	if [ -x /usr/bin/firewall-cmd ]; then
		echo "Do you want a default drop firewall?";
		echo "Current default zone: $(firewall-cmd --get-default-zone)";
		select yns in "Yes" "No" "Skip"; do
			case $yns in
				Yes )
					firewall-cmd --set-default-zone=drop;
					#firewall-cmd --add-protocol=icmp --permanent;
					firewall-cmd --add-protocol=ipv6-icmp --permanent;
					firewall-cmd --add-service=dhcpv6-client --permanent;
					if systemctl is-active -q sshd; then
						echo "sshd is enabled, allowing service";
						firewall-cmd --add-service=ssh --permanent;
					fi;
					firewall-cmd --reload;
					break;;
				No )
					firewall-cmd --set-default-zone=public;
					firewall-cmd --reload;
					break;;
				Skip )
					break;;
			esac
		done
	fi

	#Kernel Command Line
	if [ -x /usr/bin/grubby ] || [ -x /usr/sbin/grubby ]; then
		echo "Do you want a stricter kernel?";
		select ys in "Yes" "Skip"; do
			case $ys in
				Yes )
					#Keep this in sync with grub defaults

					#Memory Hardening
					#grubby --update-kernel=ALL --args="mem_encrypt=on"; #Enables SME on supported AMD platforms #XXX: can break boot, usually doesn't work but TSME in UEFI may
					#grubby --update-kernel=ALL --args="efi=disable_early_pci_dma"; #Prevents DMA during early bringup #XXX: can break boot
					grubby --update-kernel=ALL --args="init_on_alloc=1"; #Zero pages on allocation
					grubby --update-kernel=ALL --args="init_on_free=1"; #Zero pages on free
					grubby --update-kernel=ALL --args="page_alloc.shuffle=1"; #Randomize free lists
					grubby --update-kernel=ALL --args="pti=on kpti=on"; #Enable page table isolation
					grubby --update-kernel=ALL --args="randomize_kstack_offset=1"; #Randomize kernel stacks
					grubby --update-kernel=ALL --args="slab_nomerge"; #Don't merge same-size slabs
					grubby --update-kernel=ALL --args="proc_mem.force_override=never"; #Prevent direct memory writes
					if [ -f "/usr/bin/arc_summary" ] || [ -d /etc/zfs ] || [ -d /usr/share/zfs ]; then
						#may work just fine, but need to do testing, so just don't do it for now
						echo "Detected ZoL, not enabling bdev_allow_write_mounted=0";
						grubby --update-kernel=ALL --remove-args="bdev_allow_write_mounted=0";
					else
						grubby --update-kernel=ALL --args="bdev_allow_write_mounted=0"; #Prevent direct block device writes when mounted
					fi;

					#IOMMU Enablement
					grubby --update-kernel=ALL --args="iommu=force"; #Ensure it is enabled in more cases
					grubby --update-kernel=ALL --args="iommu.passthrough=0"; #Always use the IOMMU for DMA
					grubby --update-kernel=ALL --args="iommu.strict=1"; #Do not defer invalidation of hardware TLBs
					grubby --update-kernel=ALL --args="intel_iommu=on"; #Ensure the IOMMU driver is enabled
					if [ -x /usr/bin/lspci ]; then
						if lspci | grep -q "VGA .*.AMD"; then
							echo "Detected AMD GPU, disabling amd iommu forced isolation enablement";
							grubby --update-kernel=ALL --remove-args="amd_iommu=force_isolation";
						else
							echo "Enabling amd iommu forced isolation enablement. note: this breaks boot on AMD GPU systems";
							grubby --update-kernel=ALL --args="amd_iommu=force_isolation"; #Ensure the IOMMU driver is enabled #XXX can break boot with recent amd gpus
						fi;
					else
						echo "lspci unavailable, skipping enable/disablement of amd iommu forced isolation";
					fi

					#CPU Flaw Mitigations
					grubby --update-kernel=ALL --remove-args="nosmt=force"; #Switch to automatic detection
					grubby --update-kernel=ALL --args="mitigations=auto,nosmt"; #Disable SMT if vulnerable
					grubby --update-kernel=ALL --args="spec_store_bypass_disable=on ssbd=force-on"; #Enables SSB mitigations, including all userspace processes
					grubby --update-kernel=ALL --args="spectre_v2=on spectre_bhi=on"; #Enable spectre_v2 mitigations, including all userspace processes
					grubby --update-kernel=ALL --args="tsx=off"; #Disable TSX
					grubby --update-kernel=ALL --args="l1d_flush=on"; #Allow L1D flushing
					grubby --update-kernel=ALL --args="l1tf=full,force"; #Enable all mitigations
					grubby --update-kernel=ALL --args="kvm.mitigate_smt_rsb=1"; #Enable more coverage
					grubby --update-kernel=ALL --args="kvm-intel.vmentry_l1d_flush=always"; #Enable more coverage
					grubby --update-kernel=ALL --args="gather_data_sampling=force"; #Disable AVX if vulnerable

					#Misc Hardening
					#grubby --update-kernel=ALL --args="debugfs=off"; #Disable debugfs entirely #XXX: may be of use
					grubby --update-kernel=ALL --args="lockdown=confidentiality"; #Restrict userspace access to certain kernel features/attributes
					#grubby --update-kernel=ALL --args="oops=panic"; #Panic system on oops #XXX: can turn minor issues into annoyances
					grubby --update-kernel=ALL --args="vsyscall=none"; #Disable unnecessary legacy functionality
					grubby --update-kernel=ALL --args="vdso32=0"; #Disable legacy 32-bit vDSO
					grubby --update-kernel=ALL --args="efi_pstore.pstore_disable=1"; #Disable use of UEFI pstore backend
					grubby --update-kernel=ALL --args="erst_disable"; #Disable use of ACPI ERST pstore backend
					grubby --update-kernel=ALL --args="hash_pointers=always"; #Always hash pointers, pre-req for slub_debug
					grubby --update-kernel=ALL --args="systemd.ssh_auto=no"; #Disable systemd v256 automatic AF_VSOCK/AF_UNIX SSH binding
					#grubby --update-kernel=ALL --args="kvm-intel.nested=0 kvm-amd.nested=0"; #Disable nested virtualization support

					#Nice to haves
					grubby --update-kernel=ALL --args="fsck.mode=force"; #FSCK mounts every boot, systemd default is once per 30 boots
					grubby --update-kernel=ALL --args="i8042.reset=1"; #Workaround buggy laptop keyboard/touchpads
					grubby --update-kernel=ALL --args="libata.allow_tpm=1"; #OPAL support
					break;;
				Skip )
					break;;
			esac
		done

		echo "Do you want additional kernel memory checks at an extreme performance cost?";
		echo "Current status: $(grep -q 'slub_debug=FZ' /proc/cmdline && echo 'enabled' || echo 'disabled')";
		select yns in "Yes" "No" "Skip"; do
			case $yns in
				Yes )
					grubby --update-kernel=ALL --args="slub_debug=FZ"; #Enables SLUB sanity checks and red-zoning
					break;;
				No )
					grubby --update-kernel=ALL --remove-args="slub_debug=FZ";
					break;;
				Skip )
					break;;
			esac
		done

		echo "Do you want to disable 32-bit executable support?";
		echo "Current status: $(grep -q 'ia32_emulation=false' /proc/cmdline && echo 'blocked' || echo 'allowed')";
		select yns in "Yes" "No" "Skip"; do
			case $yns in
				Yes )
					grubby --update-kernel=ALL --args="ia32_emulation=false"; #Disable support for 32-bit execution
					break;;
				No )
					grubby --update-kernel=ALL --remove-args="ia32_emulation=false";
					break;;
				Skip )
					break;;
			esac
		done
	fi;

	#YAMA
	braceYamaSysctlPath="/etc/sysctl.d/99-brace-yama.conf";
	echo "Do you want to completely disable ptrace support?";
	echo "Runtime status: $(sysctl kernel.yama.ptrace_scope)";
	if [ -f "$braceYamaSysctlPath" ]; then
		echo "Current status: user override: ptrace disabled (3)";
	else
		echo "Current status: brace default: ptrace restricted (1)";
	fi;
	select yns in "Yes" "No" "Skip"; do
		case $yns in
			Yes )
				echo "kernel.yama.ptrace_scope=3" > "$braceYamaSysctlPath";
				chmod 644 "$braceYamaSysctlPath";
				sysctl -w "kernel.yama.ptrace_scope=3";
				echo "Override set and ptrace support disabled immediately";
				break;;
			No )
				if [ -f "$braceYamaSysctlPath" ]; then
					rm -v "$braceYamaSysctlPath";
					echo "Override removed, please reboot to take effect";
				else
					echo "Override was not set";
				fi;
				break;;
			Skip )
				break;;
		esac
	done
	unset braceYamaSysctlPath;

	#Hostname
	if [ -x /usr/bin/hostnamectl ]; then
		echo "Do you want a random hostname?";
		select yls in "Yes" "localhost" "Skip"; do
			case $yls in
				Yes )
					randhost=$(head /dev/urandom | tr -dc a-z | head -c8);
					if [ -x /usr/bin/pwgen ]; then
						randhost=$(pwgen -A0 8 1);
					fi;
					hostnamectl set-hostname "$randhost";
					#echo "127.0.0.1 $randhost" >> /etc/hosts;
					unset randhost;
					break;;
				localhost )
					hostnamectl set-hostname "localhost";
					break;;
				Skip )
					break;;
			esac
		done
	fi;
else
	echo "Ensuring unsafe functions are disabled";
	systemctl --user mask --now localsearch-3.service tracker-miner-fs-3.service;
	if [ -x /usr/bin/tracker3 ]; then tracker3 reset -s; fi;
	if [ -x /usr/bin/localsearch ]; then localsearch reset -s; fi;

	if [ "$XDG_CURRENT_DESKTOP" == "GNOME" ]; then
	#Power
	echo "Do you want auto suspend enabled?";
	select yn in "Yes" "No"; do
		case $yn in
			Yes )
				gsettings set org.gnome.settings-daemon.plugins.power sleep-inactive-battery-type 'suspend';
				gsettings set org.gnome.settings-daemon.plugins.power sleep-inactive-ac-type 'suspend';
				break;;
			No )
				gsettings set org.gnome.settings-daemon.plugins.power sleep-inactive-battery-type 'nothing';
				gsettings set org.gnome.settings-daemon.plugins.power sleep-inactive-ac-type 'nothing';
				break;;
		esac
	done

	#Themes
	echo "Do you want the dark theme?";
	select yn in "Yes" "No"; do
		case $yn in
			Yes )
				gsettings set org.gnome.desktop.interface color-scheme 'prefer-dark';
				if [ -f "/usr/share/themes/Adwaita-dark/index.theme" ]; then
					echo "GTK3: using legacy Adwaita dark";
					gsettings set org.gnome.desktop.interface gtk-theme 'Adwaita-dark';
				elif [ -f "/usr/share/themes/adw-gtk3-dark/index.theme" ]; then
					echo "GTK3: using unofficial Adwaita dark port";
					gsettings set org.gnome.desktop.interface gtk-theme 'adw-gtk3-dark';
				else
					echo "GTK3: dark theme unavailable";
					gsettings set org.gnome.desktop.interface gtk-theme 'Adwaita';
				fi;
				break;;
			No )
				gsettings set org.gnome.desktop.interface color-scheme 'default';
				gsettings set org.gnome.desktop.interface gtk-theme 'Adwaita';
				break;;
		esac
	done

	#Wallpaper
	echo "Would you like a solid color wallpaper?";
	select bgyrns in "Black" "Green" "Yellow" "Red" "No" "Skip"; do
		case $bgyrns in
			Black )
				gsettings set org.gnome.desktop.background primary-color '#000000';
				gsettings set org.gnome.desktop.background picture-options 'none';
				break;;
			Green )
				gsettings set org.gnome.desktop.background primary-color '#1B5E20';
				gsettings set org.gnome.desktop.background picture-options 'none';
				break;;
			Yellow )
				gsettings set org.gnome.desktop.background primary-color '#FCBD02';
				gsettings set org.gnome.desktop.background picture-options 'none';
				break;;
			Red )
				gsettings set org.gnome.desktop.background primary-color '#880505';
				gsettings set org.gnome.desktop.background picture-options 'none';
				break;;
			No )
				gsettings set org.gnome.desktop.background picture-options 'zoom';
				break;;
			Skip )
				break;;
		esac
	done
	fi;
fi;

echo "Applied the supplemental changes";
