if [ "$(/usr/bin/id -u)" -ne "0" ]; then echo 'This script needs to be run as root!'; exit 1; fi;

if [ -f /etc/fedora-release ]; then
	echo "First installing known good distro GPG keys..."
	dnf install distribution-gpg-keys;
	rpmkeys --import "/usr/share/distribution-gpg-keys/rpmfusion/RPM-GPG-KEY-rpmfusion-free-fedora-$(rpm -E %fedora)"
	echo "Enabling RPM Fusion Free...";
	echo "Expected key for F33-46: E9A4 91A3 DE24 7814 E7E0 67EA E06F 8ECD D651 FF2E";
	dnf --setopt=localpkg_gpgcheck=1 install "https://mirrors.rpmfusion.org/free/fedora/rpmfusion-free-release-$(rpm -E %fedora).noarch.rpm"
else
	echo "Currently only Fedora is supported";
fi;
