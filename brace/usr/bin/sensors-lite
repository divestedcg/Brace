if [ "$1" == "-f" ]; then useFahrenheit=true; fi;

prettyPrintOutput() {
	sort -n | column -s $'\t' -t
}

getSensorValuePretty() {
	local sensorFile;
	sensorFile="${1##*/}";
	local sensorValueRaw;
	sensorValueRaw=$(cat "$1" 2> /dev/null);
	if [ "$?" -ne "0" ] || [ -z "$sensorValueRaw" ]  || [[ ! "$sensorValueRaw" =~ ^[0-9]+$ ]]; then
		echo -n "N/A";
		return 1;
	elif [[ "$sensorFile" == "fan"*"_input" ]]; then
		echo -n "$sensorValueRaw RPM";
	elif [[ "$sensorFile" == "temp" ]] || [[ "$sensorFile" == "temp"*"_input" ]]; then
		local sensorValueC=$(( sensorValueRaw / 1000 ));
		if [ "$useFahrenheit" == "true" ]; then
			#Credit (CC BY-SA 4.0): https://stackoverflow.com/a/72457290
			local sensorValueF=$(( 18 * sensorValueC + 320 ));
			echo -n "${sensorValueF:0: -1}.${sensorValueF: -1: 1}°F";
			unset sensorValueF;
		else
			echo -n "$sensorValueC°C";
		fi;
		unset sensorValueC;
	elif [[ "$sensorFile" == "power"*"_input" ]]; then
		echo -n "$(bc <<< " scale=2; $sensorValueRaw * 0.000001 / 1") W";
	elif [[ "$sensorFile" == "in"*"_input" ]]; then
		echo -n "$(bc <<< " scale=2; $sensorValueRaw * 0.001 / 1") V";
	elif [[ "$sensorFile" == "curr"*"_input" ]]; then
		echo -n "$sensorValueRaw ? A"; #TODO
	elif [[ "$sensorFile" == "freq"*"_input" ]]; then
		echo -n "$(bc <<< " scale=2; $sensorValueRaw * 0.000001 / 1") MHz";
	else
		echo -n "$sensorValueRaw";
	fi;
	unset sensorFile sensorValueRaw;
}

getNameFile() {
	local nameFile="$1";
	if [ -r "$nameFile" ]; then
		local nameFileResult;
		nameFileResult=$(<"$nameFile");
		if [ ! -z "$nameFileResult" ]; then
			echo -ne "$nameFileResult:\t";
		else
			echo -ne "\t";
		fi;
		unset nameFileResult;
	else
		echo -ne "\t";
	fi;
	unset nameFile;
}

getOutput_direct() {
	local sensorValue="$1";
	if [ -r "$sensorValue" ]; then
		local sensorLabel;
		sensorLabel+=$(getNameFile "${sensorValue%\/*}/name"); #subsystem
		sensorLabel+=$(getNameFile "${sensorValue/_input/_label}"); #pretty
		sensorLabel+=$(sed 's|.*/||; s|_input||;' <<< "$sensorValue"); #raw
		echo -e "$sensorLabel:\t$(getSensorValuePretty "$sensorValue")";
		unset sensorLabel;
	fi;
	unset sensorValue;
}

getOutputHM() {
	#Credit (CC BY-SA 4.0): https://unix.stackexchange.com/a/139381
	while IFS= LC_ALL=C read -r -d '' -u 9 file; do
		if [[ "$file" == *"/hwmon"* ]]; then
			getOutput_direct "$file" &
		fi;
	done 9< <( find /sys/devices/ -type f -name '*_input' -exec printf '%s\0' {} + );
}

getOutputTZ_direct() {
	local sensorLabel="$1";
	local sensorValue="${sensorLabel/type/temp}";
	if [ -r "$sensorValue" ]; then
		echo -e "$(<"$sensorLabel"):\t$(getSensorValuePretty "$sensorValue")";
	fi;
	unset sensorValue sensorLabel;
}

getOutputTZ() {
	for sensorLabel in /sys/class/thermal/thermal_zone*/type; do
		if [ -r "$sensorLabel" ]; then
			getOutputTZ_direct "$sensorLabel" &
		fi;
	done;
	unset sensorLabel;
}

echo "hwmon:"
getOutputHM | prettyPrintOutput;
echo -e "\nthermal zones:"
getOutputTZ | prettyPrintOutput;

unset useFahrenheit;
