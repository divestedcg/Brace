#
# End of packages
#

#Process the primary queue
if [ -z "${packageManager}" ]; then
	echo -e "${yellow}WARNING: No primary package manager found!${coloroff}" 1>&2;
else
	echo -e "${cyan}INFO: Processing via $packageManager${coloroff}";
	echo -e "${cyan}INFO: Preparing to install: ${packagesToInstall[*]}${coloroff}";
	handleInstall "$packageManager";
	echo -e "${cyan}INFO: Preparing to remove: ${packagesToRemove[*]}${coloroff}";
	handleRemove "$packageManager";
	echo -e "${cyan}INFO: Ignoring: ${packagesToIgnore[*]}${coloroff}";
	echo -e "${cyan}INFO: Cleaning up${coloroff}";
	handleCleanup "$packageManager";
fi;
unset packagesToInstall packagesToRemove packagesToIgnore;

#Process the flatpak queue
if [ "$manageFlatpak" == "true" ]; then
	echo -e "${cyan}INFO: Processing via flatpak${coloroff}";
	echo -e "${cyan}INFO: Preparing to install: ${packagesToInstallFlatpak[*]}${coloroff}";
	handleInstall "flatpak";
	echo -e "${cyan}INFO: Preparing to remove: ${packagesToRemoveFlatpak[*]}${coloroff}";
	handleRemove "flatpak";
	echo -e "${cyan}INFO: Ignoring: ${packagesToIgnoreFlatpak[*]}${coloroff}";
	echo -e "${cyan}INFO: Cleaning up again${coloroff}";
	handleCleanup "flatpak";
fi;
unset packagesToInstallFlatpak packagesToRemoveFlatpak packagesToIgnoreFlatpak;
unset configPath usermode packageManager preferFlatpak flatpakUseFedoraRemote flatpakInstallType;

#Finish
echo -e "${green}INFO: Installer complete!${coloroff}";
