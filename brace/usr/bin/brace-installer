coloroff='\e[0m';
cyan='\e[0;36m';
green='\e[0;32m';
red='\e[0;31m';
yellow='\e[0;33m';

if [ "$(/usr/bin/id -u)" -ne "0" ]; then echo -e "${red}ERROR: This script needs to be run as root!${coloroff}"; exit 1; fi;

#
# Start Functions
#
whichPackageManager() {
	if type "zypper" > /dev/null 2>&1; then
		echo -n "zypper";
	elif type "dnf5" > /dev/null 2>&1; then
		echo -n "dnf5";
	elif type "dnf" > /dev/null 2>&1; then
		echo -n "dnf";
	elif type "yum" > /dev/null 2>&1; then
		echo -n "yum";
	elif type "pacman" > /dev/null 2>&1; then
		echo -n "pacman";
	elif type "apt" > /dev/null 2>&1; then
		echo -n "apt";
	#elif type "flatpak" > /dev/null 2>&1; then
	#	echo -n "flatpak";
	fi;
}

prepareOperation() {
	if [ "$packageManager" == "apt" ]; then
		declare -a packagesNoted=("${packagesDebian[@]}");
	elif [ "$packageManager" == "dnf5" ] || [ "$packageManager" == "dnf" ] || [ "$packageManager" == "yum" ]; then
		declare -a packagesNoted=("${packagesFedora[@]}");
	elif [ "$packageManager" == "pacman" ]; then
		declare -a packagesNoted=("${packagesArch[@]}");
	elif [ "$packageManager" == "zypper" ]; then
		declare -a packagesNoted=("${packagesSuse[@]}");
	elif [ "$packageManager" == "flatpak" ]; then
		declare -a packagesNoted=("${packagesFlathub[@]}");
	fi;
	if [ "$1" == "true" ]; then
		packagesToInstall+=("${packagesNoted[@]}");
	elif [ "$1" == "false" ]; then
		packagesToRemove+=("${packagesNoted[@]}");
	elif [ "$1" == "skip" ]; then
		packagesToIgnore+=("${packagesNoted[@]}");
	else
		echo -e "${red}ERROR: Incorrect variable for operation!${coloroff}";
		echo "debug: ${packagesFedora[*]}";
	fi;
	unset packagesNoted packagesArch packagesDebian packagesFedora packagesSuse packagesFlathub;
}

handleInstall() {
	if [ ${#packagesToInstall[@]} -eq '0' ]; then
		echo -e "${cyan}INFO: No packages to install${coloroff}" && return 0;
	fi;
	if [ "$packageManager" == "apt" ]; then
		#Credit (CC BY-SA 4.0): https://superuser.com/a/1623381
		for packageToCheck in "${packagesToInstall[@]}"
		do
			if [ -z "$(apt-cache madison $packageToCheck 2>/dev/null)" ]; then
				echo -e "${yellow}Warning: Skipping missing package: $packageToCheck ${coloroff}";
			else
				packagesToInstallReal="$packagesToInstallReal $packageToCheck";
			fi;
		done
		$packageManager install --no-install-recommends "$packagesToInstallReal";
	elif [ "$packageManager" == "dnf5" ]; then
		if $packageManager install --skip-unavailable --skip-broken "${packagesToInstall[@]}"; then
			$packageManager mark user --skip-unavailable "${packagesToInstall[@]}";
		fi;
	elif [ "$packageManager" == "dnf" ] || [ "$packageManager" == "yum" ]; then
		if $packageManager install --skip-broken "${packagesToInstall[@]}"; then
			$packageManager mark install --skip-broken "${packagesToInstall[@]}";
		fi;
	elif [ "$packageManager" == "pacman" ]; then
		$packageManager -S --needed "${packagesToInstall[@]}";
	elif [ "$packageManager" == "zypper" ]; then
		$packageManager install "${packagesToInstall[@]}";
	elif [ "$packageManager" == "flatpak" ]; then
		$packageManager install "${packagesToInstall[@]}";
	fi;
	unset packagesToInstall packageToCheck packagesToInstallReal;
}

handleRemove() {
	if [ ${#packagesToRemove[@]} -eq '0' ]; then
		echo -e "${cyan}INFO: No packages to remove${coloroff}" && return 0;
	fi;
	if [ "$packageManager" == "apt" ]; then
		$packageManager remove "${packagesToRemove[@]}";
	elif [ "$packageManager" == "dnf5" ]; then
		$packageManager remove "${packagesToRemove[@]}";
	elif [ "$packageManager" == "dnf" ] || [ "$packageManager" == "yum" ]; then
		$packageManager remove --skip-broken "${packagesToRemove[@]}";
	elif [ "$packageManager" == "pacman" ]; then
		for packageToRemove in "${packagesToRemove[@]}"; do
			$packageManager -Rsc "$packageToRemove";
		done;
	elif [ "$packageManager" == "zypper" ]; then
		$packageManager remove "${packagesToRemove[@]}";
	elif [ "$packageManager" == "flatpak" ]; then
		$packageManager remove "${packagesToRemove[@]}";
	fi;
	unset packagesToRemove packageToRemove;
}

handleCleanup() {
	if [ "$packageManager" == "apt" ]; then
		$packageManager autoremove;
	fi;
	if [ "$packageManager" == "dnf5" ] || [ "$packageManager" == "dnf" ] || [ "$packageManager" == "yum" ]; then
		$packageManager autoremove;
	fi;
	if [ "$packageManager" == "flatpak" ]; then
		$packageManager remove --unused;
	fi;
	if [ "$packageManager" == "pacman" ]; then
		$packageManager -Rns "$(pacman -Qttdq)";
		paccache -rk0;
	fi;
	if [ "$packageManager" == "zypper" ]; then
		#TODO: handle this, similar to pacman
		true;
	fi;
}
#
# End of functions
#

#
# Start of init
#
if [ -f /etc/centos-release ]; then yum install epel-release; fi; #TODO: adjust this

packageManager=$(whichPackageManager);
if [ -z "${packageManager}" ]; then
	echo -e "${red}ERROR: No package manager found!${coloroff}";
	return 1;
else
	echo -e "${cyan}INFO: Using $packageManager as package manager${coloroff}";
fi;

declare -a packagesToInstall=();
