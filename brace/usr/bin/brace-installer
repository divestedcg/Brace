declare -a packagesToIgnore=();

#XXX: replace this with an actual config to prevent arbitrary execution
if [[ $(stat --format "%a,%u,%g,%U,%G,%F" /etc/brace-installer.conf) == "644,0,0,root,root,regular file" ]]; then
	source /etc/brace-installer.conf;
else
	echo -e "${red}ERROR: Invalid config permissions!${coloroff}";
	exit 1;
fi;
#
# End of init
#

