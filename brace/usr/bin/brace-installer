coloroff='\e[0m';
cyan='\e[0;36m';
green='\e[0;32m';
red='\e[0;31m';
yellow='\e[0;33m';

configPath='/etc/brace-installer.conf';

if [ "$1" == "usermode" ]; then
	usermode="true";
	configPathUser="$HOME/.config/brace-installer.conf";
	if [ ! -f "$configPathUser" ] && [ -f "$configPath" ]; then
		grep -e "^biWant_gui_" -e "^biWant_games_" -e "^#" -e "^$" "$configPath" > "$configPathUser"; #XXX
		echo -e "${yellow}Warning: Config not found, seeding user config from system, edit, then try again${coloroff}" 1>&2;
		exit 1;
	fi;
	configPath="$configPathUser";
	unset configPathUser;
else
	if [ "$(/usr/bin/id -u)" -ne "0" ]; then echo -e "${red}ERROR: This script needs to be run as root!${coloroff}" 1>&2; exit 1; fi;
fi;

#
# Start Functions
#
whichPackageManager() {
	if type "zypper" > /dev/null 2>&1; then
		echo -n "zypper";
	elif type "dnf5" > /dev/null 2>&1; then
		echo -n "dnf5";
	elif type "dnf" > /dev/null 2>&1; then
		echo -n "dnf";
	elif type "yum" > /dev/null 2>&1; then
		echo -n "yum";
	elif type "pacman" > /dev/null 2>&1; then
		echo -n "pacman";
	elif type "apt" > /dev/null 2>&1; then
		echo -n "apt";
	fi;
}

getConfigVariable() {
	variableName="$1";
	variableOccurence=$(grep -c "^$variableName=.*;\$" "$configPath");
	if [ "$variableOccurence" -gt '1' ]; then
		echo -e "${red}ERROR: Config option declared more than once: $variableName ${coloroff}" 1>&2;
		echo -n "skip";
	elif [ "$variableOccurence" -eq '1' ]; then
		if grep -q "^$variableName=true;\$" "$configPath"; then
			echo -n "true";
		elif grep -q "^$variableName=false;\$" "$configPath"; then
			echo -n "false";
		elif grep -q "^$variableName=skip;\$" "$configPath"; then
			echo -n "skip";
		else
			echo -e "${red}ERROR: Config option invalid: $variableName ${coloroff}" 1>&2;
			echo -n "skip";
		fi;
	else
		echo -e "${yellow}Warning: Config option unset: $variableName ${coloroff}" 1>&2;
		echo -n "skip";
	fi;
	unset variableName variableOccurence;
}

prepareOperation() {
	if [ "$packageManager" == "apt" ]; then
		declare -a packagesNoted=("${packagesDebian[@]}");
	elif [ "$packageManager" == "dnf5" ] || [ "$packageManager" == "dnf" ] || [ "$packageManager" == "yum" ]; then
		declare -a packagesNoted=("${packagesFedora[@]}");
	elif [ "$packageManager" == "pacman" ]; then
		declare -a packagesNoted=("${packagesArch[@]}");
	elif [ "$packageManager" == "zypper" ]; then
		declare -a packagesNoted=("${packagesSuse[@]}");
	fi;
	if [ "$manageFlatpak" == "true" ]; then
		if [ "$flatpakUseFedoraRemote" == "true" ]; then
			declare -a packagesNotedFlatpak=("${packagesFedoraPak[@]}");
		else
			declare -a packagesNotedFlatpak=("${packagesFlathub[@]}");
		fi;
	fi;
	variableResolved=$(getConfigVariable "$1");
	if [ "$variableResolved" == "true" ]; then
		if [ ${#packagesNotedFlatpak[@]} -gt '0' ] && [ "$preferFlatpak" == "true" ]; then
			packagesToRemove+=("${packagesNoted[@]}");
			packagesToInstallFlatpak+=("${packagesNotedFlatpak[@]}");
		elif [ ${#packagesNoted[@]} -eq '0' ] && [ ${#packagesNotedFlatpak[@]} -gt '0' ]; then
			packagesToInstallFlatpak+=("${packagesNotedFlatpak[@]}");
		else
			packagesToInstall+=("${packagesNoted[@]}");
			packagesToRemoveFlatpak+=("${packagesNotedFlatpak[@]}");
		fi;
	elif [ "$variableResolved" == "false" ]; then
		packagesToRemove+=("${packagesNoted[@]}");
		packagesToRemoveFlatpak+=("${packagesNotedFlatpak[@]}");
	elif [ "$variableResolved" == "skip" ]; then
		packagesToIgnore+=("${packagesNoted[@]}");
		packagesToIgnoreFlatpak+=("${packagesNotedFlatpak[@]}");
	else
		echo -e "${red}ERROR: Incorrect variable for operation!${coloroff}" 1>&2;
	fi;
	unset variableResolved packagesNoted packagesNotedFlatpak packagesArch packagesDebian packagesFedora packagesSuse packagesFlathub packagesFedoraPak;
}

handleInstall() {
	packageManagerToUse="$1";
	if { [ ${#packagesToInstall[@]} -eq '0' ] && [ ! "$packageManagerToUse" == "flatpak" ]; } || { [ ${#packagesToInstallFlatpak[@]} -eq '0' ] && [ "$packageManagerToUse" == "flatpak" ]; }; then
		echo -e "${cyan}INFO: No packages to install${coloroff}" && return 0;
	else
		if [ "$packageManagerToUse" == "apt" ]; then
			#Credit (CC BY-SA 4.0): https://superuser.com/a/1623381
			for packageToCheck in "${packagesToInstall[@]}"
			do
				if [ -z "$(apt-cache madison $packageToCheck 2>/dev/null)" ]; then
					echo -e "${yellow}Warning: Skipping missing package: $packageToCheck ${coloroff}" 1>&2;
				else
					packagesToInstallReal="$packagesToInstallReal $packageToCheck";
				fi;
			done
			$packageManagerToUse install --no-install-recommends "$packagesToInstallReal";
		elif [ "$packageManagerToUse" == "dnf5" ]; then
			if $packageManagerToUse install --skip-unavailable --skip-broken "${packagesToInstall[@]}"; then
				$packageManagerToUse mark user --skip-unavailable "${packagesToInstall[@]}";
			fi;
		elif [ "$packageManagerToUse" == "dnf" ] || [ "$packageManagerToUse" == "yum" ]; then
			if $packageManagerToUse install --skip-broken "${packagesToInstall[@]}"; then
				$packageManagerToUse mark install --skip-broken "${packagesToInstall[@]}";
			fi;
		elif [ "$packageManagerToUse" == "pacman" ]; then
			$packageManagerToUse -S --needed "${packagesToInstall[@]}";
		elif [ "$packageManagerToUse" == "zypper" ]; then
			$packageManagerToUse install "${packagesToInstall[@]}";
		elif [ "$packageManagerToUse" == "flatpak" ]; then
			if [ "$flatpakUseFedoraRemote" == "true" ]; then
				$packageManagerToUse remote-add $flatpakInstallType --if-not-exists --title "Fedora Flatpaks" fedora oci+https://registry.fedoraproject.org
				$packageManagerToUse install $flatpakInstallType fedora "${packagesToInstallFlatpak[@]}";
			else
				$packageManagerToUse remote-add $flatpakInstallType --if-not-exists flathub https://dl.flathub.org/repo/flathub.flatpakrepo
				$packageManagerToUse install $flatpakInstallType flathub "${packagesToInstallFlatpak[@]}";
			fi;
		fi;
	fi;

	unset packageManagerToUse packageToCheck packagesToInstallReal;
}

handleRemove() {
	packageManagerToUse="$1";
	if { [ ${#packagesToRemove[@]} -eq '0' ] && [ ! "$packageManagerToUse" == "flatpak" ]; } || { [ ${#packagesToRemoveFlatpak[@]} -eq '0' ] && [ "$packageManagerToUse" == "flatpak" ]; }; then
		echo -e "${cyan}INFO: No packages to remove${coloroff}" && return 0;
	else
		if [ "$packageManagerToUse" == "apt" ]; then
			$packageManagerToUse remove "${packagesToRemove[@]}";
		elif [ "$packageManagerToUse" == "dnf5" ]; then
			$packageManagerToUse remove "${packagesToRemove[@]}";
		elif [ "$packageManagerToUse" == "dnf" ] || [ "$packageManagerToUse" == "yum" ]; then
			$packageManagerToUse remove --skip-broken "${packagesToRemove[@]}";
		elif [ "$packageManagerToUse" == "pacman" ]; then
			for packageToRemove in "${packagesToRemove[@]}"; do
				$packageManagerToUse -Rsc "$packageToRemove";
			done;
		elif [ "$packageManagerToUse" == "zypper" ]; then
			$packageManagerToUse remove "${packagesToRemove[@]}";
		elif [ "$packageManagerToUse" == "flatpak" ]; then
			$packageManagerToUse remove $flatpakInstallType "${packagesToRemoveFlatpak[@]}";
		fi;
	fi;
	unset packageManagerToUse packageToRemove;
}

handleCleanup() {
	packageManagerToUse="$1";
	if [ "$packageManagerToUse" == "apt" ]; then
		$packageManagerToUse autoremove;
	elif [ "$packageManagerToUse" == "dnf5" ] || [ "$packageManagerToUse" == "dnf" ] || [ "$packageManagerToUse" == "yum" ]; then
		$packageManagerToUse autoremove;
	elif [ "$packageManagerToUse" == "flatpak" ]; then
		$packageManagerToUse remove $flatpakInstallType --unused;
	elif [ "$packageManagerToUse" == "pacman" ]; then
		$packageManagerToUse -Rns "$(pacman -Qttdq)";
		paccache -rk0;
	elif [ "$packageManagerToUse" == "zypper" ]; then
		#TODO: handle this, similar to pacman
		true;
	fi;
	unset packageManagerToUse;
}
#
# End of functions
#

#
# Start of init
#
flatpakInstallType="--system";
if [ "$usermode" == "true" ]; then
	packageManager="usermode";
	if type "flatpak" > /dev/null 2>&1; then
		manageFlatpak="true";
		flatpakInstallType="--user";
		echo -e "${cyan}INFO: Continuing in usermode${coloroff}";
	else
		echo -e "${red}ERROR: Flatpak is required for usermode!${coloroff}" 1>&2;
		exit 1;
	fi;
else
	packageManager=$(whichPackageManager);
	if [ -z "${packageManager}" ] && ! type "flatpak" > /dev/null 2>&1; then
		echo -e "${red}ERROR: No package managers found!${coloroff}" 1>&2;
		exit 1;
	fi;

	if [ ! -r "$configPath" ]; then
		echo -e "${red}ERROR: Config file missing or unreadable!${coloroff}" 1>&2;
		exit 1;
	fi;
	if [[ $(stat --format "%a,%u,%g,%U,%G,%F" "$configPath") != "644,0,0,root,root,regular file" ]]; then
		echo -e "${red}ERROR: Invalid config permissions!${coloroff}" 1>&2;
		exit 1;
	fi;

	manageFlatpak=$(getConfigVariable "biManageFlatpak");
	if ! type "flatpak" > /dev/null 2>&1; then manageFlatpak="false"; fi;
	if [ "$manageFlatpak" == "true" ]; then
		preferFlatpak=$(getConfigVariable "biPreferFlatpak");
		flatpakUseFedoraRemote=$(getConfigVariable "biFlatpakUseFedoraRemote");
	fi;
fi;

declare -a packagesToInstall=();
declare -a packagesToInstallFlatpak=();
declare -a packagesToRemove=();
declare -a packagesToRemoveFlatpak=();
declare -a packagesToIgnore=();
declare -a packagesToIgnoreFlatpak=();
#
# End of init
#

